$hight

// json — минимальный разбор чисел и строк из JSON-текста
// import "github.com/qopix/nq-libs/json"

import "std.str"

// Пропускает пробелы, возвращает новый индекс
fn skip_ws(s: ptr, i: i64) -> i64 {
    let n = slen(s)
    while i < n {
        let c = sbyte(s, i)
        if c != 32 && c != 9 && c != 10 && c != 13 { break }
        i += 1
    }
    return i
}

// Парсит целое число начиная с i, пишет в out[0], возвращает новый индекс (-1 ошибка)
fn parse_int(s: ptr, i: i64, out: ptr<i64>) -> i64 {
    i = skip_ws(s, i)
    let n = slen(s)
    if i >= n { return -1 }
    var sign = 1
    if sbyte(s, i) == 45 {
        sign = -1
        i += 1
    }
    var val = 0
    var got = false
    while i < n {
        let c = cast(i64, sbyte(s, i))
        if c < 48 || c > 57 { break }
        val = val * 10 + (c - 48)
        got = true
        i += 1
    }
    if !got { return -1 }
    deref(out) = val * sign
    return i
}
